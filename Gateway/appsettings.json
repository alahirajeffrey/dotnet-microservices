{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/Auth/{**catch-all}"
        }
      },
      "productRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/api/v1/Product/{**catch-all}"
        }
      },
      "ordersRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/v1/Orders/{**catch-all}"
        }
      },
      "paymentRoute": {
        "ClusterId": "paymentCluster",
        "Match": {
          "Path": "/api/v1/Payment/{**catch-all}"
        }
      },
      "logRoute": {
        "ClusterId": "logCluster",
        "Match": {
          "Path": "/api/v1/Logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "auth": { "Address": "http://authservice:8080/" }
        }
      },
      "productCluster": {
        "Destinations": {
          "product": { "Address": "http://productservice:8080/" }
        }
      },
      "orderCluster": {
        "Destinations": {
          "order": { "Address": "http://orderservice:8080/" }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "payment": { "Address": "http://paymentservice:8080/" }
        }
      },
      "logCluster": {
        "Destinations": {
          "log": { "Address": "http://logservice:8080/" }
        }
      }
    }
  }
}
